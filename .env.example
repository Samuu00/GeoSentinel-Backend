# Copia questo file in .env e sostituisci i valori.

# --- PostgreSQL / PostGIS (le stesse chiavi le legge l'immagine Postgres) ---
POSTGRES_DB=geosentinel
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=change-me
# Facoltative: default localhost / 5432 (nel compose DB_HOST=postgres)
#DB_HOST=localhost
#DB_PORT=5432

# --- Redis ---
# Obbligatoria se Redis gira con --requirepass (il compose lo fa). Generare con: openssl rand -hex 24
REDIS_PASSWORD=change-me
# Facoltative: default localhost / 6379 (nel compose REDIS_HOST=redis)
#REDIS_HOST=localhost
#REDIS_PORT=6379

# --- JWT ---
# Almeno 32 byte, altrimenti l'avvio fallisce. Generare con: openssl rand -hex 32
JWT_SECRET=change-me-with-at-least-32-bytes-of-random-data

# --- MinIO (le stesse chiavi le legge l'immagine MinIO) ---
# Utente almeno 3 caratteri, password almeno 8
MINIO_ROOT_USER=geosentinel
MINIO_ROOT_PASSWORD=change-me-please
# Facoltative
#MINIO_BUCKET=geosentinel-media
# Raggiunto dall'app (nel compose: http://minio:9000)
#MINIO_ENDPOINT=http://localhost:9000
# Usato per firmare gli URL che riceve l'app: la firma include l'host, quindi deve essere l'indirizzo con cui
# il DISPOSITIVO raggiunge MinIO (altrimenti MinIO risponde 403 SignatureDoesNotMatch). Uno solo alla volta:
#   emulatore Android   http://10.0.2.2:9000
#   simulatore iOS      http://localhost:9000
#   telefono vero       http://<IP del PC nella LAN>:9000  (stessa Wi-Fi; firewall di Windows aperto sulla 9000)
#   produzione          https://media.<dominio>  (M7.6)
#MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- Push FCM (facoltative, M7.4) ---
# Senza, le notifiche SOS finiscono solo nel log. Il JSON si scarica dalla console Firebase
# (Impostazioni progetto -> Account di servizio): tenerlo fuori dal repository
#PUSH_ENABLED=true
#GOOGLE_APPLICATION_CREDENTIALS=C:/percorso/firebase-service-account.json

# Email del reset della password. Spenta di default (il codice non parte, solo un log senza dati).
# Il profilo local la accende verso Mailpit del compose (http://localhost:8025): qui servono solo per un SMTP vero
#MAIL_ENABLED=true
#MAIL_FROM=no-reply@geosentinel.dev
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USER=
#MAIL_PASSWORD=
